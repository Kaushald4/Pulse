<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Pulse lives in the menu bar and is expected to sync while its window is
	     hidden. App Nap suspends an app that looks idle, which is what left a
	     tray-initiated sync sitting at "Syncing…" until the window was brought
	     forward. This asks macOS to leave the process alone. -->
	<key>NSAppSleepDisabled</key>
	<true/>
</dict>
</plist>
